# Copie para .env e preencha a chave do provedor que for usar.
# O provedor, o modelo e a chave são lidos só pelo servidor (python -m bpmn_agent.api.servidor).

# deepseek | gemini | groq | openrouter | anthropic | ollama
LLM_PROVEDOR=deepseek
# LLM_MODELO=            # opcional: sobrescreve o modelo padrão do provedor

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Endereço do serviço. O servidor usa HOST/PORTA; a página web e o terminal usam URL.
# BPMN_API_HOST=127.0.0.1
# BPMN_API_PORTA=8000
# BPMN_API_URL=http://127.0.0.1:8000
