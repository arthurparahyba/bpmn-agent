# Copie para .env e preencha a chave do provedor que for usar.

# deepseek | gemini | groq | openrouter | anthropic | ollama
LLM_PROVEDOR=deepseek
# LLM_MODELO=            # opcional: sobrescreve o modelo padrão do provedor

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
