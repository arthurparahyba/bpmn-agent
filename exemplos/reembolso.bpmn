<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-agent (LangGraph)" exporterVersion="0.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Reembolso de despesas" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Reembolso de despesas" isExecutable="false">
    <bpmn:documentation>Funcionário pede reembolso de despesas de viagem</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Funcionário">
        <bpmn:flowNodeRef>Inicio_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Passo_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Passo_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Gestor">
        <bpmn:flowNodeRef>Passo_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decisao_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decisao_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Passo_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Financeiro">
        <bpmn:flowNodeRef>Passo_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Passo_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Espera_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio_1" name="Início">
      <bpmn:outgoing>Fluxo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Passo_1" name="Enviar pedido com comprovantes">
      <bpmn:incoming>Fluxo_1</bpmn:incoming>
      <bpmn:outgoing>Fluxo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Passo_2" name="Analisar pedido">
      <bpmn:documentation>Regra: Prazo de 5 dias úteis</bpmn:documentation>
      <bpmn:incoming>Fluxo_2</bpmn:incoming>
      <bpmn:incoming>Fluxo_10</bpmn:incoming>
      <bpmn:outgoing>Fluxo_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decisao_1" name="Pedido aprovado?">
      <bpmn:incoming>Fluxo_3</bpmn:incoming>
      <bpmn:outgoing>Fluxo_4</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Passo_3" name="Agendar pagamento">
      <bpmn:incoming>Fluxo_4</bpmn:incoming>
      <bpmn:outgoing>Fluxo_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Fim_1" name="Reembolso pago">
      <bpmn:incoming>Fluxo_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Decisao_2" name="Dá para corrigir?">
      <bpmn:incoming>Fluxo_6</bpmn:incoming>
      <bpmn:outgoing>Fluxo_7</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Passo_4" name="Avisar recusa">
      <bpmn:incoming>Fluxo_7</bpmn:incoming>
      <bpmn:outgoing>Fluxo_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Fim_2" name="Pedido recusado">
      <bpmn:incoming>Fluxo_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Passo_5" name="Corrigir pedido">
      <bpmn:incoming>Fluxo_9</bpmn:incoming>
      <bpmn:outgoing>Fluxo_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Passo_6" name="Conferir limite da política">
      <bpmn:incoming>Fluxo_11</bpmn:incoming>
      <bpmn:outgoing>Fluxo_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Espera_1" name="Aguardar data de pagamento">
      <bpmn:incoming>Fluxo_12</bpmn:incoming>
      <bpmn:outgoing>Fluxo_5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Espera_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Fluxo_1" sourceRef="Inicio_1" targetRef="Passo_1" />
    <bpmn:sequenceFlow id="Fluxo_2" sourceRef="Passo_6" targetRef="Passo_2" />
    <bpmn:sequenceFlow id="Fluxo_3" sourceRef="Passo_2" targetRef="Decisao_1" />
    <bpmn:sequenceFlow id="Fluxo_4" sourceRef="Decisao_1" targetRef="Passo_3" name="Sim" />
    <bpmn:sequenceFlow id="Fluxo_5" sourceRef="Espera_1" targetRef="Fim_1" />
    <bpmn:sequenceFlow id="Fluxo_6" sourceRef="Decisao_1" targetRef="Decisao_2" name="Não" />
    <bpmn:sequenceFlow id="Fluxo_7" sourceRef="Decisao_2" targetRef="Passo_4" name="Não" />
    <bpmn:sequenceFlow id="Fluxo_8" sourceRef="Passo_4" targetRef="Fim_2" />
    <bpmn:sequenceFlow id="Fluxo_9" sourceRef="Decisao_2" targetRef="Passo_5" name="Sim" />
    <bpmn:sequenceFlow id="Fluxo_10" sourceRef="Passo_5" targetRef="Passo_2" />
    <bpmn:sequenceFlow id="Fluxo_11" sourceRef="Passo_1" targetRef="Passo_6" />
    <bpmn:sequenceFlow id="Fluxo_12" sourceRef="Passo_3" targetRef="Espera_1" />
  </bpmn:process>
